# Application Environment Mode (development | production)
APP_ENV=development
APP_ENV_MODE=development
NODE_ENV=development
ENABLE_DEBUG=true

PORT=5000
LOG_LEVEL=debug
CORS_ORIGIN=*

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=datapure_tasks

# Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Email Configuration (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DataPure Task Manager <from@example.com>