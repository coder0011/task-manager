    {
      "name": "02. Authentication & Account",
      "item": [
        {
          "name": "Login User (Auto-stores Bearer Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    var token = (jsonData.data && jsonData.data.token) || jsonData.token;",
                  "    if (token) {",
                  "        pm.collectionVariables.set(\"bearer_token\", token);",
                  "        console.log(\"Bearer token set in collection variables:\", token);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@datapure.io\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Authenticates a user and returns a signed JWT. Pre-configured test script automatically sets collection variable {{bearer_token}}."
          }
        },
        {
          "name": "Logout User (Invalidates Session & Clears Cookies)",
          "request": {
